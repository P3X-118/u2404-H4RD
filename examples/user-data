#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ubuntu-hardened
    password: "$6$rounds=4096$changeme$hashedpassword"
    username: ubuntu
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: lvm
  packages:
    - vim
    - curl
    - wget
    - git
