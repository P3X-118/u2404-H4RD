#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ubuntu-harden
    password: "$6$rounds=4096$sgc12345$9F8E7D6C5B4A3E2F1A0B9C8D7E6F5A4B3C2D1E0F9A8B7C6D5E4F3A2B1C0D9E8F7A6B5C4D3E2F1A0B9C8D7E6F5A4"
    username: admin
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQC+user@host
  storage:
    layout:
      name: lvm
  packages:
    - vim
    - curl
    - wget
    - git
    - htop
    - net-tools
  user-data:
    package_update: true
    package_upgrade: true
  late-commands:
    - echo 'admin ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/admin
